# ============================================================
#  Configuracion del backend — Panel de Control de Servicios
#  Copiar a .env  ->  cp .env.example .env
# ============================================================

# Puerto donde escucha Express dentro del contenedor.
PORT=8000

# SEGURIDAD: secreto para firmar los JWT. OBLIGATORIO.
# Si falta, la aplicacion NO arranca (fail-fast). Generar uno con:
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia del token emitido en el login.
JWT_EXPIRES=8h

# Servicios que se agregan al crear una base SQLite por primera vez.
# Despues, la lista blanca se administra desde el panel y persiste en SQLite.
# Se aceptan nombres con o sin el sufijo ".service".
ALLOWED_SERVICES=nginx,mysql,ssh,cron,redis-server,memcached

# Ruta del archivo SQLite. Dentro de Docker apunta al volumen nombrado
# "panel-data" montado en /data para que los datos sobrevivan al contenedor.
DB_PATH=/data/panel.db

# Origen permitido por CORS (frontend en desarrollo con Vite).
# En produccion el frontend se sirve tras Nginx con rutas relativas, por lo
# que CORS deja de ser relevante, pero se mantiene para el modo dev.
CORS_ORIGIN=http://localhost:5173
