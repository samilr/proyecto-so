# ============================================================
#  Frontend — variables de entorno (solo para DESARROLLO local)
# ============================================================
#
# Este archivo NO afecta al despliegue con Docker: el .dockerignore lo
# excluye de la imagen. Solo lo lee `npm run dev` / `npm run build` cuando se
# ejecutan directamente en la maquina, fuera del contenedor.
#
#  - DESARROLLO (npm run dev): Vite sirve la SPA en http://localhost:5173 y
#    el backend escucha en http://localhost:8000. Son ORIGENES DISTINTOS, asi
#    que hay que indicar la URL completa (y el backend debe tener
#    CORS_ORIGIN=http://localhost:5173 en su .env).
#
#  - PRODUCCION (docker compose): la variable no existe dentro de la imagen,
#    por lo que el cliente usa rutas RELATIVAS (/api/...) que resuelve el
#    proxy de Nginx. Un solo origen => sin CORS.
#
# Solo las variables con prefijo VITE_ llegan al navegador; el resto las
# descarta Vite para no filtrar secretos dentro del bundle.

VITE_API_URL=http://localhost:8000
