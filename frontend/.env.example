# ============================================================
#  Frontend — variables de entorno (solo para DESARROLLO local)
#  Copiar a .env  ->  cp .env.example .env
# ============================================================
#
# VITE_API_URL indica donde esta el backend.
#
#  - DESARROLLO (npm run dev, fuera de Docker):
#      Vite sirve la SPA en http://localhost:5173 y el backend escucha en
#      http://localhost:8000. Son ORIGENES DISTINTOS, asi que hay que
#      indicar la URL completa (y el backend debe permitir ese origen en su
#      variable CORS_ORIGIN).
#
#  - PRODUCCION (docker compose):
#      Se deja VACIA o directamente no se define. El cliente usa entonces
#      rutas RELATIVAS (/api/...), que sirve el mismo Nginx del contenedor
#      frontend y reenvia al contenedor backend. Un solo origen => sin CORS.
#
# Solo las variables con prefijo VITE_ llegan al navegador; el resto las
# descarta Vite para no filtrar secretos dentro del bundle.

VITE_API_URL=http://localhost:8000
